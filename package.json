{
  "name": "square-automation-extension",
  "version": "1.0.0",
  "description": "Chrome extension for Square Dashboard automation with OpenAI agents",
  "main": "dist/background.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest",
    "package": "pnpm run build && web-ext build --source-dir=dist",
    "package:private": "pnpm run build && ./scripts/package-extension.sh",
    "distribute": "pnpm run package:private && echo 'Check releases/ directory for distribution files'",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "release:patch": "pnpm run version:patch && pnpm run distribute",
    "release:minor": "pnpm run version:minor && pnpm run distribute",
    "release:major": "pnpm run version:major && pnpm run distribute"
  },
  "dependencies": {
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@openai/agents": "^0.0.14",
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "vite": "^7.0.6",
    "web-ext": "^7.8.0",
    "zod": "^3.25.67"
  },
  "keywords": [
    "chrome-extension",
    "square",
    "automation",
    "openai",
    "typescript"
  ],
  "private": true,
  "author": "Your Name",
  "license": "MIT",
  "volta": {
    "node": "20.19.4"
  }
}
